{
  "name": "ajangsupardi/zkteco-laravel",
  "description": "Laravel package for ZKTeco biometric attendance device integration via TCP 4370",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "ᑎᗩᒍ",
      "email": "ajang@duck.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-sockets": "*",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Rynest\\Zkteco\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Rynest\\Zkteco\\ZktecoServiceProvider"
      ],
      "aliases": {
        "Zkteco": "Rynest\\Zkteco\\Facades\\Zkteco"
      }
    }
  },
  "minimum-stability": "stable"
}
